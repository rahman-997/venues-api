{
  "name": "venues-api",
  "version": "1.0.0",
  "description": "A production-minded REST API for managing venues with Express 5, TypeScript, and Zod.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx test/venues.test.ts",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "author": "Abdulrahman Hajar",
  "homepage": "https://venues-api-rahman.onrender.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/rahman-997/venues-api.git"
  },
  "keywords": [
    "express",
    "typescript",
    "zod",
    "rest-api",
    "nodejs",
    "validation",
    "layered-architecture"
  ]
}
